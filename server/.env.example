PORT=3000
# Production deployments MUST set NODE_ENV=production. Any other value
# (including this development default) mounts DevTools (/_debug) and
# Swagger (/docs, /redoc, /openapi.json) with no authentication.
NODE_ENV=development
DATABASE_URL=./data/adero.db

# Generate with: openssl rand -base64 48
# MUST be at least 32 characters. Deliberately EMPTY: a placeholder long enough
# to satisfy the schema means `cp .env.example .env` boots a server signing every
# token with a value published in this repository. Empty fails min(32) loudly.
JWT_SECRET=
JWT_EXPIRES_IN=7d
